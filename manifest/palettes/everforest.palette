# Everforest Dark
#
# Archwright palette. Thirteen tokens, consumed by every themed config.
# Generated files are produced from these values; nothing downstream
# hardcodes a colour.
name = Everforest Dark
# The nearest named libadwaita accent, for GTK4 apps - those take a
# named accent rather than an arbitrary hex.
gtk_accent = green

crust     = #1e2326
mantle    = #232a2e
base      = #2d353b
surface0  = #343f44
surface1  = #3d484d
overlay   = #859289
subtext   = #9da9a0
text      = #d3c6aa
accent    = #a7c080
alt1      = #dbbc7f
alt2      = #7fbbb3
alt3      = #83c092
alt4      = #e67e80
