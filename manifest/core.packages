# Archwright core packages, milestone 1 (base system only, no desktop).
# One package per line. '#' starts a comment. '## Group:' headers are
# parsed by the guide drift check and ignored by the installer.

## Group: base
base
base-devel
linux
linux-firmware
linux-headers

## Group: microcode
# Both vendors, deliberately. The kernel ignores the image that does not match
# the CPU, and installing both means the same disk still boots correctly if it
# is moved between an Intel and an AMD machine - which matters for a system
# whose whole point is that you can image it and hand it to someone.
amd-ucode
intel-ucode

## Group: filesystem
btrfs-progs
dosfstools
exfatprogs
snapper

## Group: boot
efibootmgr
limine
mkinitcpio

## Group: network
networkmanager
openssh
ufw

## Group: cli-staples
bash-completion
curl
git
less
man-db
nano
ripgrep
sudo
vim

## Group: hardware
sof-firmware
zram-generator

## Group: session
hyprland
uwsm
xorg-xwayland
greetd
greetd-tuigreet
polkit
mesa

## Group: portals
xdg-desktop-portal
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk

## Group: audio
pipewire
pipewire-alsa
pipewire-pulse
wireplumber

## Group: terminal
foot

## Group: fonts
ttf-jetbrains-mono-nerd

## Group: shell
waybar
mako
fuzzel
swaybg
hypridle
hyprlock
hyprpolkitagent

## Group: shell-support
wl-clipboard
libnotify
brightnessctl
