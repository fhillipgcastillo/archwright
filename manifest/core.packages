# Archwright core packages, milestone 1 (base system only, no desktop).
# One package per line. '#' starts a comment. '## Group:' headers are
# parsed by the guide drift check and ignored by the installer.

## Group: base
base
base-devel
linux
linux-firmware
linux-headers

## Group: microcode
# Both vendors, deliberately. The kernel ignores the image that does not match
# the CPU, and installing both means the same disk still boots correctly if it
# is moved between an Intel and an AMD machine - which matters for a system
# whose whole point is that you can image it and hand it to someone.
amd-ucode
intel-ucode

## Group: filesystem
btrfs-progs
dosfstools
exfatprogs
snapper
# Pacman hooks that snapshot before and after every transaction. Without this
# the whole snapshot story is scenery: snapper is configured, the boot menu
# renders per-snapshot entries, and nothing ever creates a snapshot after the
# install one. It also gives the documented single-transaction bypass the spec
# asks for - SNAP_PAC_SKIP=y pacman -Syu.
snap-pac

## Group: boot
efibootmgr
limine
mkinitcpio

## Group: network
networkmanager
openssh
ufw

## Group: cli-staples
bash-completion
curl
git
less
man-db
nano
ripgrep
sudo

## Group: hardware
sof-firmware
zram-generator

## Group: session
hyprland
uwsm
xorg-xwayland
greetd
greetd-tuigreet
polkit
mesa

## Group: portals
xdg-desktop-portal
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk

## Group: audio
pipewire
pipewire-alsa
pipewire-pulse
wireplumber

## Group: terminal
foot

## Group: fonts
ttf-jetbrains-mono-nerd

## Group: shell
waybar
mako
fuzzel
swaybg
hypridle
hyprlock
hyprpolkitagent

## Group: shell-support
wl-clipboard
libnotify
brightnessctl

## Group: applications
firefox
neovim
nautilus
gvfs
imv
mpv
evince
xdg-utils

## Group: cli-tools
eza
bat
fd
fzf
zoxide
lazygit
btop
fastfetch
tldr
jq
unzip

## Group: ai
# mise backs the lazy agent stubs; github-cli is packaged by Arch so it is a
# real package rather than a stub (D18).
mise
github-cli
# Every agent stub resolves through mise npm backend, which needs a node
# toolchain. Letting mise bootstrap its own would make the first launch of the
# first agent a large silent download at the worst possible moment, and put a
# runtime outside pacman reach. Arch packages both, so use those.
nodejs
npm

## Group: theme
# Styling is not optional: without these the GTK applications look like a
# different decade from the rest of the desktop. Both are in extra.
adw-gtk-theme
papirus-icon-theme

## Group: desktop-apps
# The graphical answers to system tasks (P2). Without these the system is a
# compositor and a terminal, which anyone can assemble from the wiki in an
# afternoon - see D23.
#
# nm-applet is the one that matters most: it is the menu that LISTS available
# wifi networks, which is the part a laptop cannot do without. The connection
# editor is a separate package and is for editing saved connections rather than
# joining new ones, so both are needed and they are not interchangeable.
network-manager-applet
nm-connection-editor
pavucontrol
blueman
# Screenshots. There was previously no way to take one at all, not even from a
# terminal. grim captures, slurp selects a region, swappy annotates.
grim
slurp
swappy
# Monitor arrangement, Hyprland-aware: nwg-displays writes hyprland monitor
# config directly rather than leaving the user to translate from a generic tool.
nwg-displays
# Nautilus cannot extract a zip without file-roller.
file-roller
# A non-modal editor, for when the person at the keyboard is not you.
gnome-text-editor
gnome-calculator
