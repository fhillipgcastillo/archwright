#!/usr/bin/env bash
# The Archwright command. One dispatcher, one subcommand per job.
#
# This is the only thing on an installed system that a user is expected to type,
# so it has to work from a plain shell with no environment set up: no sourcing,
# no shell integration, no assumptions about which agent is installed.
#
# Milestone 5 ships agent, default, mise-install and sudo-window. Milestone 6
# adds hardware and theme to the same file rather than a second command.
set -uo pipefail

AW_PREFIX="${ARCHWRIGHT_PREFIX:-/usr/share/archwright}"
AW_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/archwright"
AW_BIN_DIR="$HOME/.local/bin"
AW_WORK_DIR="$HOME/Work"
AW_FALLBACK_AGENT="claude"
# Not overridable, deliberately. An ARCHWRIGHT_SUDOERS_D override was added
# here so a unit test could prove a rejected sudo-window writes nothing. It
# could not: sudo strips the variable under env_reset, so the re-exec never saw
# it and the sandbox path was unreachable in principle - and the assertion that
# justified it created its own empty directory and then checked it was empty.
#
# So it was an environment hook in the one script on the installed system that
# writes to /etc/sudoers.d, added to satisfy a check that could not fail. The
# grant path is covered where it can actually be covered: the VM gate, against
# a real root and a real sudoers file.
AW_SUDOERS_D=/etc/sudoers.d
AW_SUDO_DROPIN="$AW_SUDOERS_D/99-archwright-sudo-window"
AW_SUDO_UNIT="archwright-sudo-window-revert"
AW_SUDO_MAX_MINUTES=240

die() { printf 'archwright: %s\n' "$*" >&2; exit 1; }
usage_error() { printf 'archwright: %s\n\n' "$*" >&2; usage >&2; exit 2; }

# --- validation ---------------------------------------------------------------
#
# These are security boundaries, not tidiness. Each value below is either used
# to build a path, interpolated into a generated script, or written into a
# sudoers rule.
#
# `[[ =~ ]]` rather than `grep -qxE`: grep -x anchors each LINE, so a value
# containing a newline passes whenever any one of its lines is legal. Bash's ^
# and $ anchor the whole string.

# A command name. Becomes a filename and is later executed.
is_command_name() { [[ ${1-} =~ ^[a-z][a-z0-9-]*$ ]]; }

# A login name. Deliberately NOT is_command_name: useradd and the installer's
# own answer-file validator both accept underscores, so reusing the command
# rule here made sudo-window permanently unusable for anyone called john_doe -
# and told them it was "refusing to write a rule" for them, which reads like an
# accusation rather than a bug.
is_user_name() { [[ ${1-} =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; }

# A mise spec: an optional backend, a package that may be scoped, and an
# optional version pin. All four shapes mise documents have to fit:
#
#   node@22                     npm:typescript@5.4.5
#   npm:@openai/codex@0.20.0    go:github.com/owner/tool@latest
#
# Interpolated into a double-quoted string in the generated stub, so anything
# that could end that string is out - the backslash included, because it
# survives the generator and is re-read as an escape, producing a stub that is
# not valid bash while the command reports success.
is_mise_spec() {
  [[ ${1-} =~ ^([a-z][a-z0-9]*:)?@?[A-Za-z0-9._/-]+(@[A-Za-z0-9._-]+)?$ ]] || return 1
  # Inert - the spec only ever reaches mise inside quotes - but a field this
  # file calls a security boundary should not carry a traversal.
  #
  # Anchored on components. The obvious `*/../*|../*|*/..` needs a slash beside
  # the dots, so a bare `..` and `npm:../x` both walked straight through it.
  case "/${1#*:}/" in */../*) return 1 ;; esac
  return 0
}

# The executable inside the package. Interpolated UNQUOTED, because it is a
# command word rather than an argument, which makes it the most dangerous of
# the three.
is_bin_name() { [[ ${1-} =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }

usage() {
  cat <<'EOF'
archwright - manage an Archwright system

usage: archwright <command> [arguments]

commands:
  agent [args...]              launch the default agent, forwarding arguments
  default agent [name]         show or set the default agent
  mise-install <spec> [name]   add a lazy launcher for any mise-installable CLI
  theme [show|list|set <name>] show, list or change the colour theme
  sudo-window [minutes]        grant passwordless sudo for a while (default 15)
  version                      print the installed Archwright version
  help                         this text

examples:
  archwright default agent codex
  archwright theme set tokyonight
  archwright mise-install npm:@scope/tool tool
  archwright sudo-window 30
EOF
}

cmd_version() {
  if [ -f "$AW_PREFIX/VERSION" ]; then
    cat "$AW_PREFIX/VERSION"
  else
    printf 'unknown (no %s/VERSION)\n' "$AW_PREFIX"
  fi
}

# --- the default agent -------------------------------------------------------

default_agent() {
  local f="$AW_STATE_DIR/default-agent" name
  if [ -r "$f" ]; then
    name="$(head -1 "$f" | tr -d '[:space:]')"
    if is_command_name "$name"; then printf '%s' "$name"; return 0; fi
  fi
  printf '%s' "$AW_FALLBACK_AGENT"
}

cmd_default() {
  local key="${1-}"
  [ -n "$key" ] || usage_error "default: which setting? (agent)"
  case "$key" in
    agent)
      shift
      if [ "$#" -eq 0 ]; then printf '%s\n' "$(default_agent)"; return 0; fi
      is_command_name "$1" \
        || usage_error "default agent: [$1] is not a command name (lowercase letters, digits and hyphens)"
      mkdir -p "$AW_STATE_DIR" || die "could not create $AW_STATE_DIR"
      printf '%s\n' "$1" > "$AW_STATE_DIR/default-agent" \
        || die "could not record the default agent"
      printf 'default agent is now %s\n' "$1"
      ;;
    *) usage_error "default: unknown setting [$key]" ;;
  esac
}

# --- launching ---------------------------------------------------------------

cmd_agent() {
  local name target
  name="$(default_agent)"

  if [ -x "$AW_BIN_DIR/$name" ]; then
    target="$AW_BIN_DIR/$name"
  elif target="$(command -v "$name" 2>/dev/null)"; then
    :
  else
    die "the default agent [$name] is not installed. Set another with: archwright default agent <name>"
  fi

  # Agents refuse to treat the home directory as a workspace - too much of it
  # is private and none of it is a project - so a launch from $HOME lands in
  # ~/Work instead. A launch from anywhere else stays put.
  if [ "$PWD" = "$HOME" ]; then
    mkdir -p "$AW_WORK_DIR" 2>/dev/null
    cd "$AW_WORK_DIR" || die "could not enter $AW_WORK_DIR"
  fi

  exec "$target" "$@"
}

# --- wrapping another CLI ----------------------------------------------------

cmd_mise_install() {
  local spec="${1-}" name="${2-}"
  [ -n "$spec" ] || usage_error "mise-install: which package? e.g. npm:@scope/tool"
  [ "$#" -le 2 ] || usage_error "mise-install: too many arguments (spec, then optionally a command name)"
  is_mise_spec "$spec" \
    || usage_error "mise-install: [$spec] is not a usable package spec (expected something like npm:@scope/tool)"

  # Infer the command from the tail of the spec when it is not given: drop the
  # scope, then the backend, then the version pin. Right for npm:tool,
  # npm:@scope/tool, node@22 and npm:@openai/codex@0.20.0 alike.
  #
  # The pin strip is not decoration. Version pins were legalised in the
  # validator without it, so every pinned spec passed validation and was then
  # rejected here as "not a usable command name" - the feature accepted the
  # input and still refused to do the work.
  if [ -z "$name" ]; then
    name="${spec##*/}"
    name="${name##*:}"
    name="${name%@*}"
  fi
  is_command_name "$name" \
    || usage_error "mise-install: [$name] is not a usable command name; pass one explicitly"
  # The name is also the executable inside the package, and goes into the stub
  # unquoted. is_command_name already excludes everything dangerous, but say so
  # explicitly rather than relying on two rules happening to coincide.
  is_bin_name "$name" \
    || usage_error "mise-install: [$name] is not a usable executable name"

  mkdir -p "$AW_BIN_DIR" || die "could not create $AW_BIN_DIR"
  if [ -e "$AW_BIN_DIR/$name" ]; then
    printf 'archwright: %s already exists in %s - left alone\n' "$name" "$AW_BIN_DIR"
    return 0
  fi

  cat > "$AW_BIN_DIR/$name" <<EOF
#!/usr/bin/env bash
# Generated by 'archwright mise-install $spec'.
#
# mise resolves and caches the package the first time this runs, so that run
# needs a network connection. Every run after it is local.
exec mise exec "$spec" -- $name "\$@"
EOF
  chmod 0755 "$AW_BIN_DIR/$name" || die "could not make $name executable"
  printf 'added %s -> %s\n' "$AW_BIN_DIR/$name" "$spec"
}

# --- theming -----------------------------------------------------------------
#
# Seven palettes ship. Changing between them rewrites only the colour files this
# project owns; hyprland.conf, waybar/style.css, foot.ini, the mako config and
# fuzzel.ini are yours and are never touched.
#
# This is the one subcommand that sources the installed library rather than
# carrying its own copy of the logic. The validators are duplicated because
# they guard input this command handles before anything is installed; a theme
# change happens on a machine that by definition has /usr/share/archwright on
# it, and a second copy of a template renderer is exactly the drift the
# duplicated validators needed a test to police.
AW_THEME_LIB="$AW_PREFIX/lib"
AW_PALETTES="$AW_PREFIX/palettes"
AW_WALLPAPERS="$AW_PREFIX/wallpapers"

current_theme() {
  local t
  t="$(head -1 "$AW_STATE_DIR/theme" 2>/dev/null | tr -d '[:space:]')"
  if is_command_name "$t"; then printf '%s' "$t"; else printf 'mocha'; fi
}

cmd_theme() {
  local sub="${1:-show}"
  case "$sub" in
    show)
      local t; t="$(current_theme)"
      local name
      name="$(sed -n 's/^[[:space:]]*name[[:space:]]*=[[:space:]]*//p' \
                "$AW_PALETTES/$t.palette" 2>/dev/null | head -1)"
      if [ -n "$name" ]; then printf '%s (%s)\n' "$t" "$name"
      else printf '%s\n' "$t"; fi
      ;;
    list)
      [ -d "$AW_PALETTES" ] || die "no palettes installed at $AW_PALETTES"
      local cur f id name
      cur="$(current_theme)"
      for f in "$AW_PALETTES"/*.palette; do
        [ -f "$f" ] || continue
        id="${f##*/}"; id="${id%.palette}"
        name="$(sed -n 's/^[[:space:]]*name[[:space:]]*=[[:space:]]*//p' "$f" | head -1)"
        if [ "$id" = "$cur" ]; then printf '* %-12s %s\n' "$id" "$name"
        else printf '  %-12s %s\n' "$id" "$name"; fi
      done
      ;;
    set)
      shift
      local want="${1-}"
      [ -n "$want" ] || usage_error "theme set: which theme? try: archwright theme list"
      [ "$#" -le 1 ] || usage_error "theme set: too many arguments"
      is_command_name "$want" \
        || usage_error "theme set: [$want] is not a theme name"
      [ -f "$AW_PALETTES/$want.palette" ] \
        || die "no such theme: $want. Try: archwright theme list"
      [ -r "$AW_THEME_LIB/theme.sh" ] \
        || die "the theme library is missing from $AW_THEME_LIB"

      # shellcheck source=/dev/null
      . "$AW_THEME_LIB/common.sh"
      # shellcheck source=/dev/null
      . "$AW_THEME_LIB/theme.sh"

      aw_theme_load "$AW_PALETTES/$want.palette"
      # Read back by aw_theme_render inside the library sourced just above, not
      # used in this file.
      # shellcheck disable=SC2034
      AW_PAL_home="$HOME"
      local n
      n="$(aw_theme_generate "$AW_PREFIX/theme/theme-files.tsv" \
             "$AW_PREFIX/theme" "$HOME" theme)"
      [ "$n" -gt 0 ] || die "no colour files were written"

      mkdir -p "$AW_STATE_DIR"
      ln -sfn "$AW_WALLPAPERS/$want.png" "$AW_STATE_DIR/wallpaper.png" \
        || die "could not point the wallpaper at $want"
      printf '%s\n' "$want" > "$AW_STATE_DIR/theme" \
        || die "could not record the theme"

      # Reload what can be reloaded. Each is best-effort: running this outside a
      # graphical session is legitimate, and none of these failing means the
      # theme was not written.
      hyprctl reload >/dev/null 2>&1
      makoctl reload >/dev/null 2>&1
      systemctl --user restart archwright-swaybg.service >/dev/null 2>&1
      systemctl --user restart waybar.service >/dev/null 2>&1
      archwright-apply-gtk-theme >/dev/null 2>&1

      printf 'theme is now %s (%s)\n' "$want" "${AW_PAL_name:-$want}"
      # foot rereads nothing, by design - it has no reload mechanism at all.
      printf 'already-open terminals keep the old colours; new ones pick it up.\n'
      ;;
    *) usage_error "theme: unknown action [$sub] (show, list, set)" ;;
  esac
}

# --- the sudo window ---------------------------------------------------------
#
# Agent work means a long run of commands that each want root. The alternatives
# are typing a password every few minutes, or a permanent NOPASSWD line that
# outlives the reason for it. This is the middle: a grant that removes itself.
#
# Four things make it safe enough to ship, and three of them exist because a
# review found the naive version leaves permanent passwordless root behind:
#
#   * The rule is validated with visudo BEFORE it goes anywhere near
#     /etc/sudoers.d. A malformed file there locks you out of root on the
#     machine, permanently, with no way back in from a running session.
#   * The revert is a systemd timer, not a background sleep, so a crashed
#     terminal or a killed shell cannot leave the window open.
#   * The timer is scheduled BEFORE the grant is installed. The other order has
#     a window - Ctrl-C, a power cut - where the rule exists and nothing is due
#     to remove it. A timer with no file to delete is a no-op; a file with no
#     timer is permanent root.
#   * The deadline is a wall-clock time, not "N minutes from now". A monotonic
#     timer does not advance across suspend, so closing the lid two minutes into
#     a fifteen-minute window used to leave thirteen minutes still to run,
#     whenever the machine woke up - days later, if that is when it woke.
#
# The remaining hole is a reboot: /etc/sudoers.d is persistent and a transient
# timer is not, so a machine that reboots mid-window would come back with the
# grant still in place and nothing left to remove it. That is closed outside
# this file, by the tmpfiles rule lib/70-ai.sh installs, which deletes the
# drop-in at every boot.

cmd_sudo_window() {
  local minutes user
  # An omitted argument means the default. An argument that was GIVEN must be
  # valid, so `sudo-window ""` is an error rather than a silent 15 minutes.
  if [ "$#" -eq 0 ]; then minutes=15; else minutes="$1"; fi
  # For a command that grants root, "I typed something and it was ignored" is
  # not an acceptable outcome.
  [ "$#" -le 1 ] || usage_error "sudo-window: too many arguments (expected just a number of minutes)"

  case "$minutes" in
    ''|*[!0-9]*) usage_error "sudo-window: [$minutes] is not a whole number of minutes" ;;
  esac
  [ "$minutes" -ge 1 ] 2>/dev/null \
    || usage_error "sudo-window: the window must be at least 1 minute"
  [ "$minutes" -le "$AW_SUDO_MAX_MINUTES" ] \
    || usage_error "sudo-window: $AW_SUDO_MAX_MINUTES minutes is the maximum; longer is just NOPASSWD with extra steps"

  # Everything below writes to /etc, so re-exec as root only once the argument
  # is known to be good. Nothing has been created at this point.
  if [ "$(id -u)" -ne 0 ]; then
    command -v sudo >/dev/null 2>&1 || die "sudo-window needs sudo or root"
    exec sudo -- "$0" sudo-window "$minutes"
  fi

  user="${SUDO_USER:-root}"
  is_user_name "$user" \
    || die "sudo-window: [$user] is not a valid login name"
  getent passwd "$user" >/dev/null 2>&1 \
    || die "sudo-window: no such account: $user"

  # Build and CHECK the rule before anything is scheduled or installed.
  local tmp
  tmp="$(mktemp)" || die "could not create a temporary file"
  chmod 0440 "$tmp"

  # The deadline is emitted in UTC with an explicit suffix, and read back in
  # UTC. `date` formats in the CALLER's timezone; systemd evaluates OnCalendar
  # in the SYSTEM's. sudo passes TZ through, so those two are not always the
  # same, and a mismatch puts the deadline in the past - at which point systemd
  # finds no future occurrence and marks the timer inactive WITHOUT firing it.
  # Saying UTC on both sides removes the disagreement.
  local deadline_utc deadline_local
  deadline_utc="$(date -u -d "+${minutes} minutes" '+%Y-%m-%d %H:%M:%S UTC')" \
    || die "could not work out when the window should close"
  deadline_local="$(date -d "+${minutes} minutes" '+%Y-%m-%d %H:%M:%S %Z')" \
    || die "could not work out when the window should close"

  cat > "$tmp" <<EOF
# Written by 'archwright sudo-window $minutes' at $(date '+%Y-%m-%d %H:%M:%S %Z').
# Due to be removed at $deadline_local, and removed at boot regardless.
# If you are reading this well after that time, remove it by hand.
$user ALL=(ALL:ALL) NOPASSWD: ALL
EOF

  if ! visudo -cf "$tmp" >/dev/null 2>&1; then
    rm -f "$tmp"
    die "the generated rule did not pass visudo - refusing to install it"
  fi

  # From here on an EXISTING window may be in play - asking for a second one is
  # how you shorten or extend the first. Stopping its timer below means that
  # from this point any failure must revoke, not just decline: leaving the old
  # drop-in with its timer cancelled is the permanent-root state this whole
  # function exists to avoid. Revoking is always the safe direction, so every
  # exit path from here removes the file, and a trap covers the signals.
  local staged="$AW_SUDOERS_D/.99-archwright-sudo-window.staged"
  # shellcheck disable=SC2317  # reached via trap, not by falling through
  _sudo_window_abort() {
    rm -f "$tmp" "$staged" "$AW_SUDO_DROPIN"
    systemctl stop "$AW_SUDO_UNIT.timer" >/dev/null 2>&1
  }
  trap '_sudo_window_abort; exit 1' INT TERM HUP

  # Revoke BEFORE cancelling the old timer, not after. The trap covers signals,
  # but nothing covers SIGKILL or a hang, and between stopping the old timer and
  # arming the new one there are three D-Bus round trips - hundreds of
  # milliseconds on a loaded machine. Dying in that gap would leave the old
  # grant on disk with its revert already cancelled. Removing the file first
  # makes that gap empty: there is nothing to leak, and the success path
  # re-creates the grant a few lines below.
  rm -f "$AW_SUDO_DROPIN"

  # Clear any previous window, unit and all. Stopping the timer alone leaves a
  # failed transient service behind, and systemd refuses to create a unit whose
  # name already exists - which would wedge sudo-window until someone ran
  # reset-failed by hand, with an error message that gives no hint of it.
  systemctl stop "$AW_SUDO_UNIT.timer" "$AW_SUDO_UNIT.service" >/dev/null 2>&1
  systemctl reset-failed "$AW_SUDO_UNIT.timer" "$AW_SUDO_UNIT.service" >/dev/null 2>&1

  # Schedule the revert FIRST, on BOTH clocks. A timer with several triggers
  # fires at whichever comes first, and the two fail in opposite directions:
  #
  #   --on-active   monotonic. Immune to timezone confusion and to the clock
  #                 being stepped, but does not advance while the machine is
  #                 suspended.
  #   --on-calendar wall clock. Fires on resume if its time passed during a
  #                 suspend, but goes inactive WITHOUT FIRING if its time is
  #                 already past when it is evaluated - which a stepped clock
  #                 or a timezone mismatch can arrange.
  #
  # Either one alone has a case where the window never closes. Together they do
  # not. AccuracySec is pinned because systemd otherwise gives timers a minute
  # of slack and coalesces them with other wakeups, which would make a stated
  # deadline a suggestion.
  systemd-run --quiet --unit="$AW_SUDO_UNIT" \
      --on-active="${minutes}m" \
      --on-calendar="$deadline_utc" \
      --timer-property=AccuracySec=1s \
      /usr/bin/rm -f "$AW_SUDO_DROPIN" \
    || { _sudo_window_abort; die "could not schedule the revert - any previous window has been revoked"; }

  # Install atomically. `install` truncates in place, and a concurrent sudo that
  # reads a half-written rule gets a parse error and refuses to run. A rename
  # within the same directory is atomic, and sudo ignores any file in
  # sudoers.d whose name contains a dot, so the staging name is never parsed.
  if ! install -m 0440 -o root -g root "$tmp" "$staged" \
     || ! mv -f "$staged" "$AW_SUDO_DROPIN"; then
    _sudo_window_abort
    die "could not install $AW_SUDO_DROPIN - nothing is granted"
  fi
  rm -f "$tmp"

  # The timer was armed before the file existed. For a very short window on a
  # loaded machine it could have fired against nothing, leaving a grant with
  # no pending revert.
  if ! systemctl is-active --quiet "$AW_SUDO_UNIT.timer"; then
    # The common abort, not a bare rm: if is-active failed for some reason
    # other than "already elapsed", the timer is still running and wants
    # stopping too. Every exit path past the trap goes through one function.
    _sudo_window_abort
    die "the revert timer is not pending - nothing is granted"
  fi
  trap - INT TERM HUP

  printf 'passwordless sudo granted to %s until %s.\n' "$user" "$deadline_local"
  printf 'it closes on its own, and at the next boot whatever happens.\n'
  printf 'close it now with: sudo rm -f %s\n' "$AW_SUDO_DROPIN"
}

# --- dispatch ----------------------------------------------------------------

main() {
  local cmd="${1:-help}"
  [ "$#" -gt 0 ] && shift
  case "$cmd" in
    help|-h|--help) usage ;;
    version|--version) cmd_version ;;
    agent)            cmd_agent "$@" ;;
    default)          cmd_default "$@" ;;
    mise-install)     cmd_mise_install "$@" ;;
    theme)            cmd_theme "$@" ;;
    sudo-window)      cmd_sudo_window "$@" ;;
    *)                usage_error "unknown command [$cmd]" ;;
  esac
}

main "$@"
