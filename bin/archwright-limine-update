#!/usr/bin/env bash
# Regenerate /boot/limine.conf: the default entry plus one per snapper snapshot.
#
# WHY THIS EXISTS
#
# The upstream tooling that does this (limine-entry-tool, limine-snapper-sync)
# is a Java project requiring gradle and a ~330MB GraalVM download to build,
# and it is not in Arch's official repositories. Building it during every
# install is not acceptable, and Archwright does not run a package repository
# to ship a prebuilt copy. So Archwright generates the entries itself.
#
# HOW IT WORKS
#
# Limine cannot read inside the LUKS container, so every boot artifact must
# live on the unencrypted ESP: the kernel, the microcode, and the initramfs.
# Booting a snapshot is then only a matter of a different `rootflags=subvol=`
# on the kernel command line, which Limine supplies per entry as plain text.
#
# This is also precisely why Archwright does NOT use a Unified Kernel Image: a
# UKI bakes its command line into the binary, so a snapshot entry would need
# its own UKI. Plain kernel + initramfs keeps the command line editable per
# entry, which is what makes this script forty lines instead of a compiler.
set -euo pipefail

CONF="${AW_LIMINE_CONF:-/boot/limine.conf}"
BOOTDIR="${AW_BOOT_DIR:-/boot}"
SNAPDIR="${AW_SNAPSHOT_DIR:-/.snapshots}"
CMDLINE_FILE="${AW_CMDLINE_FILE:-/etc/archwright/cmdline}"
TIMEOUT="${AW_LIMINE_TIMEOUT:-3}"

[ -f "$CMDLINE_FILE" ] || {
  echo "archwright-limine-update: $CMDLINE_FILE not found" >&2
  exit 1
}
base_cmdline="$(tr -d '\n' < "$CMDLINE_FILE")"

kernel="$BOOTDIR/vmlinuz-linux"
[ -f "$kernel" ] || { echo "archwright-limine-update: no kernel at $kernel" >&2; exit 1; }
initramfs="$BOOTDIR/initramfs-linux.img"
[ -f "$initramfs" ] || { echo "archwright-limine-update: no initramfs at $initramfs" >&2; exit 1; }

# Microcode must be loaded BEFORE the real initramfs, so it is emitted first.
emit_modules() {
  local uc
  for uc in amd-ucode.img intel-ucode.img; do
    [ -f "$BOOTDIR/$uc" ] && printf '    module_path: boot():/%s\n' "$uc"
  done
  printf '    module_path: boot():/initramfs-linux.img\n'
}

emit_entry() {
  local title="$1" cmdline="$2"
  printf '\n/%s\n' "$title"
  printf '    protocol: linux\n'
  printf '    path: boot():/vmlinuz-linux\n'
  printf '    cmdline: %s\n' "$cmdline"
  emit_modules
}

snapshot_field() {
  local info="$1" field="$2"
  [ -f "$info" ] || return 0
  sed -n "s:.*<$field>\(.*\)</$field>.*:\1:p" "$info" | head -1
}

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

{
  printf '# Generated by archwright-limine-update. Do not edit.\n'
  printf '# Regenerate with: archwright-limine-update\n'
  printf 'timeout: %s\n' "$TIMEOUT"
  printf 'default_entry: 1\n'

  emit_entry "Archwright" "$base_cmdline rootflags=subvol=@ rw"

  # Snapshots are read-only, so they boot ro. This is for inspecting or
  # recovering from a bad update, not for running from day to day - use
  # `snapper rollback` once you have confirmed the snapshot is the one you
  # want.
  count=0
  for snap in "$SNAPDIR"/*/snapshot; do
    [ -d "$snap" ] || continue
    num="$(basename "$(dirname "$snap")")"
    case "$num" in ''|*[!0-9]*) continue ;; esac
    [ "$num" = "0" ] && continue
    info="$(dirname "$snap")/info.xml"
    desc="$(snapshot_field "$info" description)"
    date="$(snapshot_field "$info" date)"
    label="Snapshot ${num}"
    [ -n "$date" ] && label="$label — ${date}"
    [ -n "$desc" ] && label="$label — ${desc}"
    emit_entry "$label (read-only)" \
      "$base_cmdline rootflags=subvol=@snapshots/${num}/snapshot ro"
    count=$((count + 1))
  done
  printf '\n# %s snapshot entries generated\n' "$count"
} > "$tmp"

install -m 0644 "$tmp" "$CONF"
echo "archwright-limine-update: wrote $CONF"
