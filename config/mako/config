# Archwright default notification appearance.
# Seeded into ~/.config/mako/ on first install; yours thereafter.
font=JetBrainsMono Nerd Font 10
border-size=2
border-radius=8
padding=12
default-timeout=5000
anchor=top-right
margin=10
max-visible=5

# Colours last, in their own file, so changing theme does not rewrite this one.
# Critical notifications never time out on their own - that rule lives with the
# colours because it is set in the same urgency block.
include=~/.config/mako/colors
