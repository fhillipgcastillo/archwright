# Archwright default terminal configuration.
# Seeded into ~/.config/foot/ on first install; yours thereafter.
#
# Note: foot cannot reload its configuration, so a running terminal keeps the
# old settings after an edit. Open a new one.

font=JetBrainsMono Nerd Font:size=11
pad=8x8

[cursor]
style=beam

[scrollback]
lines=10000

# Colours live in their own file so changing theme does not rewrite this one.
# foot documents include as taking an absolute path, which is why this line is
# generated rather than shipped as a literal.
include=@home@/.config/foot/colors.ini
