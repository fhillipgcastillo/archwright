# @name@ - generated by Archwright. Do not edit.
#
# This file is regenerated every time the theme changes. Put your own overrides
# in hyprland.conf, which sources this and is never rewritten.
#
# Hyprland takes colours as rgb(rrggbb) with no '#'.

$aw_crust    = rgb(@crust_hex@)
$aw_mantle   = rgb(@mantle_hex@)
$aw_base     = rgb(@base_hex@)
$aw_surface0 = rgb(@surface0_hex@)
$aw_surface1 = rgb(@surface1_hex@)
$aw_overlay  = rgb(@overlay_hex@)
$aw_subtext  = rgb(@subtext_hex@)
$aw_text     = rgb(@text_hex@)
$aw_accent   = rgb(@accent_hex@)
$aw_alt1     = rgb(@alt1_hex@)
$aw_alt2     = rgb(@alt2_hex@)
$aw_alt3     = rgb(@alt3_hex@)
$aw_alt4     = rgb(@alt4_hex@)

# Sourced last from hyprland.conf, so these win over anything above them.
general {
    col.active_border = rgb(@accent_hex@) rgb(@alt2_hex@) 45deg
    col.inactive_border = rgb(@surface0_hex@)
}

decoration {
    shadow {
        color = rgba(@crust_hex@aa)
    }
}

group {
    col.border_active = rgb(@accent_hex@)
    col.border_inactive = rgb(@surface0_hex@)
}

misc {
    background_color = rgb(@base_hex@)
}
