# Archwright default launcher.
# Seeded into ~/.config/fuzzel/ on first install; yours thereafter.
#
# The include is FIRST for the same reason as in foot.ini: it belongs to the
# default section, and anything after a [section] header is read as an option
# of that section. Absolute path, as fuzzel documents.
include=@home@/.config/fuzzel/colors.ini

font=JetBrainsMono Nerd Font:size=12
lines=12
width=40
horizontal-pad=16
vertical-pad=12
inner-pad=4

[border]
width=2
radius=8
