# @name@ - generated by Archwright. Do not edit.
#
# Regenerated on every theme change. The mako config includes this last and is
# yours; edits there survive.
#
# mako's urgency levels are low, normal and critical. There is no 'high'.
background-color=@mantle@
text-color=@text@
border-color=@accent@

[urgency=low]
border-color=@overlay@
text-color=@subtext@

[urgency=critical]
border-color=@alt4@
default-timeout=0
